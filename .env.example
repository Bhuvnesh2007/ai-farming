# ─── IBM watsonx.ai ───────────────────────────────────────────────────────────
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Granite model IDs (available on watsonx.ai)
GRANITE_TEXT_MODEL=ibm/granite-13b-instruct-v2
GRANITE_VISION_MODEL=ibm/granite-vision-3-2-2b   # fallback to text if unavailable

# ─── Weather API (free, no key required) ──────────────────────────────────────
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# ─── Vector store ─────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./backend/vectorstore/chroma_db
CHROMA_COLLECTION=farming_knowledge

# ─── App settings ─────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO
OFFLINE_MODE=false          # set true to use stub responses when APIs are down

# ─── Optional: IBM Cloud Object Storage (for image uploads in production) ─────
COS_ENDPOINT=
COS_API_KEY=
COS_BUCKET=
